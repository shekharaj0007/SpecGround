# Optional. Leave blank to answer from retrieved text (no model call).
# A placeholder such as sk-ant-your-key-here is treated as unset.
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5
ANTHROPIC_GUARD_MODEL=claude-haiku-4-5

# Optional. Embeddings stay on the local hasher in either case. No model download.
OPENAI_API_KEY=

# SQLite by default. Set a Postgres URL for Docker or Render.
# Leave this unset to use data/specground.db without Postgres.
DATABASE_URL=sqlite:///./data/specground.db
UPLOAD_DIR=./data/uploads
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
EMBEDDING_DIM=384
